# Alle Werte vor Produktivbetrieb gegen GetCapabilities / ?f=pjson verifizieren.
VITE_AIRSPACE_WMS_URL=
VITE_AIRSPACE_WMS_LAYERS=
VITE_AIRSPACE_WFS_URL=
VITE_AIRSPACE_WFS_TYPENAME=
# lon/lat (Default) oder urn:ogc:def:crs:EPSG::4326 (lat/lon)
VITE_AIRSPACE_WFS_BBOX_CRS=EPSG:4326
VITE_AIRSPACE_FIELD_NAME=name
VITE_AIRSPACE_FIELD_TYPE=type
VITE_AIRSPACE_FIELD_LOWER=lower_limit
VITE_AIRSPACE_FIELD_UPPER=upper_limit

VITE_ENV_ARCGIS_URL=
VITE_ENV_ARCGIS_WHERE=1=1
VITE_ENV_FIELD_NAME=name
VITE_ENV_FIELD_CATEGORY=kategorie
VITE_ENV_CATEGORIES=Nationalpark,Naturschutzgebiet

# CORS-Proxy: off | fallback | always. Bei "always" Hosts der Rasterkacheln eintragen (WMS/basemap).
VITE_PROXY_URL=/proxy
VITE_PROXY_MODE=fallback
VITE_PROXY_TILE_HOSTS=

VITE_BASEMAP_TILES=
VITE_GEOCODER=on

# Proxy-Server (server/proxy.mjs)
PROXY_ALLOW_HOSTS=
PORT=8787
